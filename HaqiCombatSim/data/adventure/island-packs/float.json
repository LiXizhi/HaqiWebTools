              "name": "禾舟",
              "count": 1
            }
          ]
        }
      ],
      "startDialog": [
        {
          "npcId": 860101,
          "text": "现实世界的城市也有旧名和新名。你可以从世界地图去看看河岸和桥，再回来聊。",
          "buttons": [
            {
              "action": "gotonext",
              "label": "接着说吧。"
            }
          ]
        },
        {
          "npcId": 860101,
          "text": "也可以先听禾舟。",
          "buttons": [
            {
              "action": "doaccept",
              "label": "求救声也应该留下。"
            }
          ]
        }
      ],
      "talks": [
        {
          "npcId": 860102,
          "label": "我想问问这条线索。",
          "dialog": [
            {
              "npcId": 860102,
              "text": "我看过风帆岛的旧记录。那里的塔只保存“成功的声音”。最后一次求救，被写成了欢呼。",
              "buttons": [
                {
                  "action": "donpcdialoged",
                  "label": "我明白这条线索了。"
                }
              ]
            }
          ]
        }
      ],
      "endDialog": [
        {
          "npcId": 860101,
          "text": "两种名字的谜团解开了，求救声却仍没有答案。",
