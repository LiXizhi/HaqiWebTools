{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "haqi-runes-dev",
			"type": "shell",
			"command": "npm run dev -- --port 8791",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "haqi-import-preview",
			"type": "shell",
			"command": "npm run dev -- --port 5173",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "haqi server: start",
			"type": "shell",
			"command": "npm run presence",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"problemMatcher": {
				"owner": "haqi-server",
				"pattern": {
					"regexp": "^(?!x)x"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^",
					"endsPattern": "presence ready"
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": false
			}
		}
	]
}