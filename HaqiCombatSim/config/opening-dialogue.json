{
  "version": 1,
  "quests": {
    "63000": {
      "description": "听青龙讲解移动和交谈的方法，开始营地里的第一课。",
      "startDialog": [
        {
          "text": "我是青龙。来，试试你的第一道魔法。",
          "reply": "我来试试"
        },
        {
          "text": "点地面走路，点居民说话。一起去看看！",
          "reply": "记住了"
        }
      ],
      "endDialog": [
        {
          "text": "会走会聊了！去认识营地里的朋友吧。",
          "reply": "谢谢你"
        }
      ],
      "talks": {}
    },
    "63001": {
      "description": "向茜茜学习选牌与搭档配合，再向青龙回报。",
      "startDialog": [
        {
          "text": "去找茜茜，试试怎么和伙伴配合。",
          "reply": "我来试试"
        }
      ],
      "endDialog": [
        {
          "text": "接下来，赢一顶带新招式的帽子吧。",
          "reply": "谢谢你"
        }
      ],
      "talks": {
        "36200": {
          "label": "请指教",
          "dialog": [
            {
              "text": "点一张牌，再点目标。抱抱龙会帮你看局势。",
              "reply": "我来选招式"
            }
          ]
        },
        "36201": {
          "label": "请指教",
          "dialog": [
            {
              "text": "你选牌，我的伙伴也会出招。一起配合吧！",
              "reply": "一起配合"
            }
          ]
        }
      }
    },
    "63002": {
