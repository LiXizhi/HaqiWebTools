      "startDialog": [
        {
          "npcId": 860003,
          "text": "我站在爸爸门外，却不知道第一句话怎么说。你愿意先陪他说句话吗？",
          "buttons": [
            {
              "action": "doaccept",
              "label": "把这句话当面说吧。"
