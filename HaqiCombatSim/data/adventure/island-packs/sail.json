              "name": "守环人",
              "count": 1
            }
          ]
        }
      ],
      "startDialog": [
        {
          "npcId": 860200,
          "text": "明天是回航庆典。塔里却传出“别开门”。守环人说那是旧欢呼，你愿意听另一种说法吗？",
          "buttons": [
            {
              "action": "doaccept",
              "label": "先把求救声听完。"
            }
          ]
        }
      ],
      "talks": [
        {
          "npcId": 860201,
          "label": "我想问问这条线索。",
          "dialog": [
            {
              "npcId": 860201,
              "text": "我守了三十年。那段声音不是欢呼。我认得岑宁的母亲，她当时在求救。",
              "buttons": [
                {
                  "action": "donpcdialoged",
                  "label": "我明白这条线索了。"
                }
              ]
            }
          ]
        }
      ],
      "endDialog": [
        {
          "npcId": 860200,
          "text": "莉风拿下庆典横幅。她没有宣布答案，只请织帆人岑宁一起来听。",
          "buttons": [
            {
              "action": "dofinished",
              "label": "她也需要听见这段声音。"
            }
          ]
        }
      ],
      "rewards": [
