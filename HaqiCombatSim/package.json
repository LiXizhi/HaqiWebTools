{
    "name": "haqi-combat-sim",
    "private": true,
    "version": "0.1.0",
    "description": "魔法哈奇 2D 网页战斗模拟器：无 UI 战斗引擎 + 人机对战 + 批量胜率模拟 + 数值建议",
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1 --open /Haqi.html",
        "build": "npm run check:maps && vite build",
        "preview": "vite preview --host 127.0.0.1 --open /Haqi.html",
        "plan:release": "npm run build && node uploadRelease.mjs --dry-run",
        "upload": "npm run build && node uploadRelease.mjs",
        "verify:release": "node uploadRelease.mjs --verify-only",
        "export": "node scripts/export_data.mjs --config ../../config/Aries --out data --version both",
        "test": "node --test tests/*.test.mjs",
        "sim": "node scripts/run_batch.mjs",
        "prepare:monster-art": "node scripts/package_monster_art.mjs",
        "export:quests": "python3 scripts/export_quest_catalog.py && python3 scripts/export_monster_catalog.py && python3 scripts/prepare_boss_art.py && node scripts/package_quests.mjs",
        "export:adventure": "python3 scripts/export_adventure.py && npm run generate:maps",
        "export:fishing": "python3 scripts/export_fishing.py",
        "export:runes": "python scripts/export_runes.py",
        "assets:adventure": "node scripts/prepare_adventure_assets.mjs",
        "check:adventure": "node scripts/check_adventure.mjs && node scripts/prepare_adventure_assets.mjs --check",
        "plan:adventure-cdn": "node scripts/publish_adventure_media.mjs",
        "verify:adventure-cdn": "node scripts/publish_adventure_media.mjs --verify",
        "audit:effects": "node scripts/audit_spell_effects.mjs",
        "prepare:effects": "node scripts/prepare_spell_effects.mjs",
        "export:spell-names": "python3 scripts/export_spell_names.py",
        "prepare:spell-art": "python3 scripts/prepare_spell_art.py && python3 scripts/draw_spell_fallbacks.py",
        "plan:spell-art-cdn": "node scripts/publish_spell_art.mjs",
        "verify:spell-art-cdn": "node scripts/publish_spell_art.mjs --verify",
        "generate:maps": "node scripts/generate_island_maps.mjs",
        "check:maps": "node scripts/generate_island_maps.mjs --check",
        "export:dungeons": "python3 scripts/export_dungeons.py && node scripts/report_dungeons.mjs"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "devDependencies": {
        "vite": "7.3.6",
        "ws": "^8.21.3"
    }
}
