        {
          "npcId": 860002,
          "label": "我想问问这条线索。",
          "dialog": [
            {
              "npcId": 860002,
              "text": "小禾是我，也是岑伯给女儿起的小名。这封信写给我，不是给她。",
              "buttons": [
                {
                  "action": "donpcdialoged",
                  "label": "我明白这条线索了。"
                }
              ]
            }
          ]
        }
      ],
      "endDialog": [
        {
          "npcId": 860001,
          "text": "名字相同，收信的人却不同。信里提到一盏灯，灯罩上有三道裂纹。",
          "buttons": [
            {
              "action": "dofinished",
              "label": "我们去找那盏裂灯。"
            }
          ]
        }
      ],
