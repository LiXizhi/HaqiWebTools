          "label": "请指教",
          "dialog": [
            {
              "text": "伙伴受伤了？生命魔法能帮它恢复。",
              "reply": "记住了"
            }
          ]
        },
        "36210": {
          "label": "请指教",
          "dialog": [
            {
              "text": "死亡魔法能边攻击，边吸取生命。",
              "reply": "记住了"
            }
