      "talks": {
        "36206": {
          "label": "请指教",
          "dialog": [
            {
              "text": "敌人多？烈火擅长用火焰一起攻击。",
              "reply": "记住了"
            }
          ]
        },
        "36207": {
          "label": "请指教",
          "dialog": [
            {
              "text": "寒冰先稳住防守，再找机会反击。",
              "reply": "记住了"
            }
