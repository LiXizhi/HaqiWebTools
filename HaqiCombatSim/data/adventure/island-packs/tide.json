      "startDialog": [
        {
          "npcId": 860001,
          "text": "信封写着“小禾”。岑伯以为是女儿。去问问抄信员吧。",
          "buttons": [
            {
              "action": "doaccept",
              "label": "我去确认收信的人。"
            }
