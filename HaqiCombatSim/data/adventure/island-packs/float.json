          ]
        }
      ],
      "startDialog": [
        {
          "npcId": 860100,
          "text": "旧守图机还在封锁第二条路。它把不同名字当成错误。让它停下，我们才能改正记录。",
          "buttons": [
            {
              "action": "doaccept",
              "label": "让每条路都有名字。"
            }
          ]
        }
      ],
      "talks": [],
      "endDialog": [
        {
          "npcId": 860100,
          "text": "守图机停下后，居民共同写下路名和用途。新图没有把旧图烧掉，旁边注明了旧路的变化。",
          "buttons": [
            {
              "action": "dofinished",
              "label": "旧图也留在旁边。"
            }
          ]
        }
      ],
      "rewards": [
