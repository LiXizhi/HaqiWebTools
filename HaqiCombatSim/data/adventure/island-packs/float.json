      "startDialog": [
        {
          "npcId": 860101,
          "text": "我叫那口井“回家井”。旧档里叫“北井”。名字不同，就不能是同一口井吗？",
          "buttons": [
            {
              "action": "doaccept",
              "label": "旧名字也值得留下。"
            }
