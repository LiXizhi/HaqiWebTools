      ],
      "startDialog": [
        {
          "npcId": 860100,
          "text": "欢迎来到浮岸岛。蓝湾人说我们的地图是假的。请先问问米拉，她亲手画过那张图。",
          "buttons": [
            {
              "action": "doaccept",
              "label": "先找两张图相同的地方。"
            }
          ]
        }
      ],
      "talks": [
        {
          "npcId": 860101,
          "label": "我想问问这条线索。",
          "dialog": [
            {
              "npcId": 860101,
              "text": "蓝湾是我们家门口的海岸。涨水时，我们走高桥。旧地图只画低路，所以看起来像两座岛。",
              "buttons": [
                {
                  "action": "donpcdialoged",
                  "label": "我明白这条线索了。"
                }
              ]
            }
          ]
        }
      ],
      "endDialog": [
        {
          "npcId": 860100,
          "text": "芦笙把两张图叠在灯下。瀑布和水井重合了，路却不同。谁只保存了一种走法？",
          "buttons": [
            {
              "action": "dofinished",
              "label": "我们去问问旧路。"
            }
          ]
        }
      ],
      "rewards": [
        {
