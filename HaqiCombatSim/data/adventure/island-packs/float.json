      "startDialog": [
        {
          "npcId": 860103,
          "text": "旧路还有岩藤兽。把路清开后，我会检查桥脚。检查前别让商队上桥。",
          "buttons": [
            {
              "action": "doaccept",
              "label": "先挡住危险的桥。"
            }
          ]
        }
      ],
      "talks": [],
      "endDialog": [
        {
          "npcId": 860103,
          "text": "道路安全了，桥脚仍有裂缝。修桥师立起围栏。赢了战斗，也不能让坏桥变成好桥。",
          "buttons": [
            {
              "action": "dofinished",
              "label": "桥修好之前别走。"
            }
          ]
        }
      ],
