          "age": 28
        },
        {
          "id": "journey:sail:elite-1:line-2",
          "role": "npc",
          "speaker": "莉风",
          "text": "它只保存了胜利。我要知道，被剪掉的那句是什么。",
          "sex": "female",
          "age": 28
        },
        {
          "id": "journey:sail:elite-1:line-3",
          "role": "player",
          "speaker": "我",
          "text": "先别替它补一个好结局。",
          "reward": "hp",
          "sex": "female"
        },
        {
          "id": "journey:sail:elite-1:line-4",
          "role": "npc",
          "speaker": "莉风",
          "text": "纸翼兽守着旧门。它们不让别的声音进来。",
          "sex": "female",
          "age": 28
        },
        {
          "id": "journey:sail:elite-1:line-5",
          "role": "player",
          "speaker": "我",
          "text": "我来清开档案室的路。",
          "reward": "attack",
          "sex": "female"
        },
        {
          "id": "journey:sail:elite-1:line-6",
          "role": "npc",
          "speaker": "莉风",
          "text": "听到求救时，我们可以停下来。不需要马上说出答案。",
          "sex": "female",
          "age": 28
        },
        {
          "id": "journey:sail:elite-1:line-7",
          "role": "player",
          "speaker": "我",
          "text": "听不清，我会再问一次。",
          "reward": "defense",
          "sex": "female"
        },
        {
          "id": "journey:sail:elite-1:line-8",
          "role": "narrator",
          "speaker": "旁白",
          "text": "你推开外门。欢呼声后，隐约响起一个人的名字。",
          "sex": "female",
          "age": 28
        }
      ],
      "sceneBiome": "park",
      "arenaCount": 3
    },
    {
