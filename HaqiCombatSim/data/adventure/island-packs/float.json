              "id": 860101,
              "name": "米拉",
              "count": 1
            }
          ]
        }
      ],
      "startDialog": [
        {
          "npcId": 860102,
          "text": "我把账本公开了。米拉愿意谈怎么补回桥费，但她不想只听道歉。",
          "buttons": [
            {
              "action": "doaccept",
              "label": "我们把账单公开。"
            }
          ]
        }
      ],
      "talks": [
        {
          "npcId": 860101,
          "label": "我想问问这条线索。",
          "dialog": [
            {
              "npcId": 860101,
              "text": "先修通我们用的路。每一笔钱都记下来，让两边都能看见。父亲的故事，我们以后再谈。",
              "buttons": [
                {
                  "action": "donpcdialoged",
                  "label": "我明白这条线索了。"
                }
              ]
            }
          ]
        }
      ],
      "endDialog": [
        {
          "npcId": 860102,
          "text": "禾舟接受了。第一张公开账单钉在井边，两个港口的名字都在上面。",
          "buttons": [
            {
              "action": "dofinished",
              "label": "以后大家都能看到账。"
            }
          ]
        }
      ],
      "rewards": [
        {
          "choice": -1,
          "schoolFilter": false,
          "items": [
