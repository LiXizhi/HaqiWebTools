  "journeys": [
    {
      "id": "journey:tide:elite-1",
      "kind": "elite",
      "island": "tide",
      "name": "失声的潮灯",
      "recommendedLevel": 60,
      "sourceId": "dungeon:HaqiTown_YYsDream_S1",
      "partySize": 1,
      "floors": null,
      "enemyTemplateIds": [
        "pack:tide:guardian-1",
        "pack:tide:guardian-2",
        "pack:tide:guardian-3",
        "pack:tide:guardian-4"
      ],
      "story": [
        {
          "id": "journey:tide:elite-1:line-1",
          "role": "narrator",
          "speaker": "旁白",
          "text": "潮灯洞的水面上，灯影一亮一暗。",
          "sex": "male",
          "age": 28
        },
        {
          "id": "journey:tide:elite-1:line-2",
          "role": "npc",
          "speaker": "阿澜",
          "text": "旧灯还在重复“不要回来”。听完下一句，才知道这是谁说的。",
          "sex": "male",
          "age": 28
        },
        {
          "id": "journey:tide:elite-1:line-3",
          "role": "player",
          "speaker": "我",
          "text": "我想听见整句话。",
          "reward": "hp",
          "sex": "male"
        },
        {
          "id": "journey:tide:elite-1:line-4",
          "role": "npc",
          "speaker": "阿澜",
          "text": "潮壳兽挡住了石阶。它们只认旧灯的命令。",
          "sex": "male",
          "age": 28
        },
        {
          "id": "journey:tide:elite-1:line-5",
          "role": "player",
          "speaker": "我",
          "text": "我们一起清开石阶。",
          "reward": "attack",
          "sex": "male"
        },
        {
          "id": "journey:tide:elite-1:line-6",
          "role": "npc",
          "speaker": "阿澜",
          "text": "洞口的灯还亮着。累了，我们就沿灯道回去。",
          "sex": "male",
          "age": 28
        },
        {
          "id": "journey:tide:elite-1:line-7",
          "role": "player",
          "speaker": "我",
          "text": "我会留意回去的路。",
          "reward": "defense",
          "sex": "male"
        },
        {
          "id": "journey:tide:elite-1:line-8",
          "role": "narrator",
          "speaker": "旁白",
          "text": "水声盖住了半句回答。你向灯光走去。",
          "sex": "male",
          "age": 28
        }
      ],
      "sceneBiome": "lake",
      "arenaCount": 3
    },
    {
      "id": "journey:tide:elite-2",
      "kind": "elite",
      "island": "tide",
      "name": "被风吹散的回信",
      "recommendedLevel": 60,
      "sourceId": "dungeon:HaqiTown_YYsDream_S1",
      "partySize": 2,
      "floors": null,
      "enemyTemplateIds": [
        "pack:tide:guardian-1",
        "pack:tide:guardian-2",
        "pack:tide:guardian-3",
        "pack:tide:guardian-4"
      ],
      "story": [
        {
          "id": "journey:tide:elite-2:line-1",
          "role": "narrator",
          "speaker": "旁白",
          "text": "几封信卡在潮洞的石缝里。封口还完好。",
          "sex": "male",
          "age": 28
        },
        {
          "id": "journey:tide:elite-2:line-2",
          "role": "npc",
          "speaker": "阿澜",
          "text": "阿澜曾守着这些信。他怕坏消息，也怕自己判断错了。",
          "sex": "male",
          "age": 28
        },
        {
          "id": "journey:tide:elite-2:line-3",
          "role": "player",
          "speaker": "我",
          "text": "先看看信写给谁。",
          "reward": "hp",
          "sex": "male"
        },
        {
          "id": "journey:tide:elite-2:line-4",
          "role": "npc",
          "speaker": "阿澜",
          "text": "浪影兽在信袋旁打转。先别让伙伴碰到暗流。",
          "sex": "male",
          "age": 28
        },
        {
          "id": "journey:tide:elite-2:line-5",
          "role": "player",
          "speaker": "我",
          "text": "我来守住安全的路。",
          "reward": "attack",
          "sex": "male"
        },
        {
          "id": "journey:tide:elite-2:line-6",
          "role": "npc",
          "speaker": "阿澜",
          "text": "信上的日期，有人按涨潮记，有人按退潮记。",
          "sex": "male",
          "age": 28
        },
        {
          "id": "journey:tide:elite-2:line-7",
          "role": "player",
          "speaker": "我",
          "text": "我们一起核对日期。",
          "reward": "defense",
          "sex": "male"
        },
        {
          "id": "journey:tide:elite-2:line-8",
          "role": "narrator",
          "speaker": "旁白",
          "text": "洞壁留下两排刻痕。它们都指向同一个夜晚。",
          "sex": "male",
          "age": 28
        }
      ],
      "sceneBiome": "lake",
      "arenaCount": 5
    },
    {
      "id": "journey:tide:tower",
      "kind": "tower",
      "island": "tide",
      "name": "潮汐岛回声试炼塔",
      "recommendedLevel": 60,
      "sourceId": "dungeon:HaqiTown_LightHouse_S1",
      "partySize": 3,
      "floors": 60,
      "enemyTemplateIds": [
        "pack:tide:guardian-1",
        "pack:tide:guardian-2",
        "pack:tide:guardian-3",
        "pack:tide:guardian-4"
      ],
      "story": [
        {
          "id": "journey:tide:tower:line-1",
          "role": "narrator",
          "speaker": "旁白",
          "text": "塔门上挂着一盏旧灯，灯罩有三道裂纹。",
          "sex": "male",
          "age": 28
        },
        {
          "id": "journey:tide:tower:line-2",
          "role": "npc",
          "speaker": "阿澜",
          "text": "这里有六十层旧记录。每十层都能回来休息和领取奖励。",
          "sex": "male",
          "age": 28
        },
        {
          "id": "journey:tide:tower:line-3",
          "role": "player",
          "speaker": "我",
          "text": "今天先走好第一层。",
          "reward": "hp",
          "sex": "male"
        },
        {
          "id": "journey:tide:tower:line-4",
          "role": "npc",
          "speaker": "阿澜",
          "text": "塔里的守卫不分谁在等谁，只照着旧记录行动。",
          "sex": "male",
          "age": 28
        },
        {
          "id": "journey:tide:tower:line-5",
          "role": "player",
          "speaker": "我",
          "text": "我会看清再出手。",
          "reward": "attack",
          "sex": "male"
        },
        {
          "id": "journey:tide:tower:line-6",
          "role": "npc",
          "speaker": "阿澜",
          "text": "记录可能写错。看到熟悉的名字，也别急着下结论。",
          "sex": "male",
          "age": 28
        },
        {
          "id": "journey:tide:tower:line-7",
          "role": "player",
          "speaker": "我",
          "text": "我们把话听完整。",
          "reward": "defense",
          "sex": "male"
        },
        {
          "id": "journey:tide:tower:line-8",
          "role": "narrator",
          "speaker": "旁白",
          "text": "第一层的门打开了。灯影落在两只空杯子上。",
          "sex": "male",
          "age": 28
        }
      ],
      "sceneBiome": "lake"
    }
