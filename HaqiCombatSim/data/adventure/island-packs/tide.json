    {
      "id": 870000,
      "title": "灯还亮着",
      "description": "在潮汐岛与岑伯交谈，再回去确认线索。",
      "region": "tide",
      "startNpc": 860000,
      "endNpc": 860000,
      "repeat": false,
      "prerequisites": [],
      "requirements": [
        {
          "id": 214,
          "name": "等级",
          "min": 60,
          "max": null
        }
      ],
      "groups": [
        {
          "kind": "talk",
          "condition": 0,
          "mode": 0,
          "items": [
            {
              "id": 860001,
              "name": "岑伯",
              "count": 1
            }
          ]
        }
      ],
      "startDialog": [
        {
          "npcId": 860000,
          "text": "灯塔每晚都亮，船却三年没来。岑伯说，是我把船赶走了。你能先听听他吗？",
          "buttons": [
            {
              "action": "doaccept",
              "label": "我先听听岑伯怎么说。"
            }
          ]
        }
      ],
      "talks": [
        {
          "npcId": 860001,
          "label": "我想问问这条线索。",
          "dialog": [
            {
              "npcId": 860001,
              "text": "我没有赶船。我只说，别走旧海路。可女儿再也没有回信。",
              "buttons": [
                {
                  "action": "donpcdialoged",
                  "label": "我明白这条线索了。"
                }
              ]
            }
          ]
        }
      ],
      "endDialog": [
        {
          "npcId": 860000,
          "text": "岑伯桌上放着两只杯子。他每天都把另一只擦干净。我们先别判断他。",
          "buttons": [
            {
              "action": "dofinished",
              "label": "他还在等她。"
            }
          ]
        }
      ],
      "rewards": [
        {
          "choice": -1,
          "schoolFilter": false,
          "items": [
