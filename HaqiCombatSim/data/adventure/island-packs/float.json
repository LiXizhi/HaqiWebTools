  "journeys": [
    {
      "id": "journey:float:elite-1",
      "kind": "elite",
      "island": "float",
      "name": "两岸的旧测量台",
      "recommendedLevel": 70,
      "sourceId": "dungeon:HaqiTown_YYsDream_S1",
      "partySize": 1,
      "floors": null,
      "enemyTemplateIds": [
        "pack:float:guardian-1",
        "pack:float:guardian-2",
        "pack:float:guardian-3",
        "pack:float:guardian-4"
      ],
      "story": [
        {
          "id": "journey:float:elite-1:line-1",
          "role": "narrator",
          "speaker": "旁白",
          "text": "测量台的一面画着高桥，另一面画着低桥。",
          "sex": "female",
          "age": 28
        },
        {
          "id": "journey:float:elite-1:line-2",
          "role": "npc",
          "speaker": "芦笙",
          "text": "两岸都说自己的图是真的。先看看它们在什么天气使用。",
          "sex": "female",
          "age": 28
        },
        {
          "id": "journey:float:elite-1:line-3",
          "role": "player",
          "speaker": "我",
          "text": "晴天和雨天的路一样吗？",
          "reward": "hp",
          "sex": "female"
        },
        {
          "id": "journey:float:elite-1:line-4",
          "role": "npc",
          "speaker": "芦笙",
          "text": "守图机正封住另一条桥。它不问谁要从那里过。",
          "sex": "female",
          "age": 28
        },
        {
          "id": "journey:float:elite-1:line-5",
          "role": "player",
          "speaker": "我",
          "text": "我来保护这条路。",
          "reward": "attack",
          "sex": "female"
        },
        {
          "id": "journey:float:elite-1:line-6",
          "role": "npc",
          "speaker": "芦笙",
          "text": "清开守卫后，还要检查桥脚。战斗不能修好裂缝。",
          "sex": "female",
          "age": 28
        },
        {
          "id": "journey:float:elite-1:line-7",
          "role": "player",
          "speaker": "我",
          "text": "坏桥要先围起来。",
          "reward": "defense",
          "sex": "female"
        },
        {
          "id": "journey:float:elite-1:line-8",
          "role": "narrator",
          "speaker": "旁白",
          "text": "测量尺慢慢转动。两条路线在尺上碰到同一个点。",
          "sex": "female",
          "age": 28
        }
      ],
      "sceneBiome": "forest",
      "arenaCount": 3
    },
    {
      "id": "journey:float:elite-2",
      "kind": "elite",
      "island": "float",
      "name": "瀑布下的空白图",
      "recommendedLevel": 70,
      "sourceId": "dungeon:HaqiTown_YYsDream_S1",
      "partySize": 2,
      "floors": null,
      "enemyTemplateIds": [
        "pack:float:guardian-1",
        "pack:float:guardian-2",
        "pack:float:guardian-3",
        "pack:float:guardian-4"
      ],
      "story": [
        {
          "id": "journey:float:elite-2:line-1",
          "role": "narrator",
          "speaker": "旁白",
          "text": "瀑布后的墙上，有一块没有名字的港口。",
          "sex": "female",
          "age": 28
        },
        {
          "id": "journey:float:elite-2:line-2",
          "role": "npc",
          "speaker": "芦笙",
          "text": "那里一直有人住。名字被擦掉了，他们仍得找路回家。",
          "sex": "female",
          "age": 28
        },
        {
          "id": "journey:float:elite-2:line-3",
          "role": "player",
          "speaker": "我",
          "text": "我想听听他们怎么走。",
          "reward": "hp",
          "sex": "female"
        },
        {
          "id": "journey:float:elite-2:line-4",
          "role": "npc",
          "speaker": "芦笙",
          "text": "岩藤兽占住了旧路。居民只能从湿滑的石边绕行。",
          "sex": "female",
          "age": 28
        },
        {
          "id": "journey:float:elite-2:line-5",
          "role": "player",
          "speaker": "我",
          "text": "我们先清开旧路。",
          "reward": "attack",
          "sex": "female"
        },
        {
          "id": "journey:float:elite-2:line-6",
          "role": "npc",
          "speaker": "芦笙",
          "text": "别替居民选路。修好之后，问他们需要什么。",
          "sex": "female",
          "age": 28
        },
        {
          "id": "journey:float:elite-2:line-7",
          "role": "player",
          "speaker": "我",
          "text": "新图上也留一块空白。",
          "reward": "defense",
          "sex": "female"
        },
        {
          "id": "journey:float:elite-2:line-8",
          "role": "narrator",
          "speaker": "旁白",
          "text": "水声稍稍变小。你看见墙底还留着一个旧名字。",
          "sex": "female",
          "age": 28
        }
      ],
      "sceneBiome": "forest",
      "arenaCount": 5
    },
    {
      "id": "journey:float:tower",
      "kind": "tower",
      "island": "float",
      "name": "浮岸岛回声试炼塔",
      "recommendedLevel": 70,
      "sourceId": "dungeon:HaqiTown_LightHouse_S1",
      "partySize": 3,
      "floors": 80,
      "enemyTemplateIds": [
        "pack:float:guardian-1",
        "pack:float:guardian-2",
        "pack:float:guardian-3",
        "pack:float:guardian-4"
      ],
      "story": [
        {
          "id": "journey:float:tower:line-1",
          "role": "narrator",
          "speaker": "旁白",
          "text": "塔门旁放着两张地图，边角都已经磨破。",
          "sex": "female",
          "age": 28
        },
        {
          "id": "journey:float:tower:line-2",
          "role": "npc",
          "speaker": "芦笙",
          "text": "八十层测量记录，没有一张能替所有人选路。",
          "sex": "female",
          "age": 28
        },
        {
          "id": "journey:float:tower:line-3",
          "role": "player",
          "speaker": "我",
          "text": "我们一层一层看。",
          "reward": "hp",
          "sex": "female"
        },
        {
          "id": "journey:float:tower:line-4",
          "role": "npc",
          "speaker": "芦笙",
          "text": "守卫仍把不同的路线当作错误。先让它们停下来。",
          "sex": "female",
          "age": 28
        },
        {
          "id": "journey:float:tower:line-5",
          "role": "player",
          "speaker": "我",
          "text": "不同也可以是真的。",
          "reward": "attack",
          "sex": "female"
        },
        {
          "id": "journey:float:tower:line-6",
          "role": "npc",
          "speaker": "芦笙",
          "text": "每十层可以休息。带回一条线索，比硬撑更有用。",
          "sex": "female",
          "age": 28
        },
        {
          "id": "journey:float:tower:line-7",
          "role": "player",
          "speaker": "我",
          "text": "累了就先回去。",
          "reward": "defense",
          "sex": "female"
        },
        {
          "id": "journey:float:tower:line-8",
          "role": "narrator",
          "speaker": "旁白",
          "text": "门后是一把长尺。尺上有两种颜色的刻度。",
          "sex": "female",
          "age": 28
        }
      ],
      "sceneBiome": "forest"
    }
  ],
