      ],
      "startDialog": [
        {
          "npcId": 860203,
          "text": "我不想烧掉庆典。那些获救的人也是真的。但我的妈妈，不能只剩一面帆。请告诉莉风。",
          "buttons": [
            {
              "action": "doaccept",
              "label": "白补丁也可以露出来。"
            }
          ]
        }
      ],
      "talks": [
        {
          "npcId": 860200,
          "label": "我想问问这条线索。",
          "dialog": [
            {
              "npcId": 860200,
              "text": "我们保留庆典，也加上没有回来的人的名字。明天可以高兴，也可以难过。",
              "buttons": [
                {
                  "action": "gotonext",
                  "label": "接着说吧。"
                }
              ]
            },
