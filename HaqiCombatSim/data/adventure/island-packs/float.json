      "talks": [
        {
          "npcId": 860102,
          "label": "我想问问这条线索。",
          "dialog": [
            {
              "npcId": 860102,
              "text": "这是同一口井。我父亲按方向记路，米拉的奶奶按生活记路。两个人都没有说谎。",
              "buttons": [
