      ],
      "endDialog": [
        {
          "npcId": 860003,
          "text": "父女终于在船坞见面。岑宁说：我也想你。过去的三年没有回来，但今晚可以一起吃饭。",
          "buttons": [
            {
              "action": "dofinished",
              "label": "今晚就一起吃饭。"
            }
          ]
        }
      ],
