      "endDialog": [
        {
          "npcId": 860101,
          "text": "旧档员禾舟找到一张更老的图。两种名字本来并排写着，后来一边被涂白。",
          "buttons": [
            {
              "action": "dofinished",
              "label": "名字是怎么被擦掉的？"
